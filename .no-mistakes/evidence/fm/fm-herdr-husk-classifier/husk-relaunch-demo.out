HERDR HUSK CLASSIFIER (public backend functions)

== done binding + bare shell (provider-death husk) ==
pane_agent_state=no-agent
recovery_state=dead

== done binding + live omp foreground (must still refuse) ==
pane_agent_state=live
recovery_state=alive

== closed pane / missing endpoint (recreate) ==
pane_agent_state=dead
recovery_state=missing

