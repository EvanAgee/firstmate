#!/usr/bin/env bash
set -eu

printf '%s\n' "$*" >> "$FM_EVIDENCE_GH_LOG"

case "${FM_EVIDENCE_GH_MODE:-}" in
  backfill)
    case "$*" in
      *'repo:SuperDuperIT/aos is:pr is:merged sort:updated-desc'*'first: 10'*)
        printf '%s\n' '[1]: "91\tfm/task-backfill\t2025-08-26T12:00:00Z\t2025-08-26T12:10:00Z\thttps://github.com/SuperDuperIT/aos/pull/91"'
        ;;
      *'is:pr is:merged sort:updated-desc'*'first: 10'*)
        printf '%s\n' '[]'
        ;;
      *) exit 1 ;;
    esac
    ;;
  pr)
    if [ "${1:-}" = api ] && [ "${3:-}" = /graphql ]; then
      printf '%s\n' 0
    elif [ "${1:-}" = api ] && [ "${2:-}" = GET ]; then
      printf '%s\n' \
        'merged: true' \
        'merged_at: "2025-08-26T12:10:00Z"' \
        'pr_opened_at: "2025-08-26T12:00:00Z"'
    fi
    ;;
  *) exit 2 ;;
esac
