{
  "note": "Human notes can explain the pools, but the resolver selects only by class, pin, enabled state, and live-worker counts.",
  "rules": [
    {
      "class": "researcher",
      "when": "Research, diagnosis, audits, and planning.",
      "use": [
        { "harness": "claude", "model": "fable", "effort": "xhigh" },
        { "harness": "codex", "model": "gpt-5.6-sol", "effort": "xhigh" },
        { "harness": "pi", "model": "xai/grok-4.6", "effort": "high" }
      ],
      "why": "Every member meets the research floor."
    },
    {
      "class": "builder",
      "when": "Features, fixes, refactors, and other ship tasks.",
      "use": [
        { "harness": "pi", "model": "xai/grok-4.6", "effort": "high" },
        { "harness": "codex", "model": "gpt-5.6-sol", "effort": "high" },
        { "harness": "claude", "model": "claude-opus-4-8", "effort": "high" }
      ],
      "pin": { "harness": "codex", "model": "gpt-5.6-sol", "effort": "high" },
      "why": "The pin selects Codex until it is removed."
    },
    {
      "class": "designer",
      "when": "Visual design and interface polish.",
      "use": [
        { "harness": "claude", "model": "fable", "effort": "xhigh" },
        { "harness": "codex", "model": "gpt-5.6-sol", "effort": "xhigh" }
      ]
    },
    {
      "class": "tester",
      "when": "Test writing, browser checks, and bug reproduction.",
      "use": [
        { "harness": "claude", "model": "opus", "effort": "high" },
        { "harness": "codex", "model": "gpt-5.6-sol", "effort": "xhigh" },
        { "harness": "pi", "model": "xai/grok-4.6", "effort": "high", "enabled": false }
      ],
      "why": "The disabled member stays out of selection until the captain turns it on."
    }
  ],
  "default": [
    { "harness": "codex", "model": "gpt-5.6-sol", "effort": "high" },
    { "harness": "pi", "model": "xai/grok-4.6", "effort": "high" }
  ],
  "defaultPin": { "harness": "codex", "model": "gpt-5.6-sol", "effort": "high" }
}
